{
  "name": "contract-desk",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Local Contract & Document Manager",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js & vite",
    "test": "node test/acceptance.mjs && node test/acceptance.mjs wasm && node test/phone.mjs",
    "test:e2e": "playwright test",
    "app": "vite build && electron .",
    "dist": "vite build && electron-builder --linux AppImage --win nsis",
    "dist:linux": "vite build && electron-builder --linux AppImage",
    "dist:win": "vite build && electron-builder --win nsis",
    "android:build": "vite build && cap sync android && cd android && ./gradlew assembleDebug",
    "android:install": "\"$ANDROID_HOME/platform-tools/adb\" install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "demo:video": "node scripts/record-demo.mjs",
    "test:e2e:watch": "WATCH=1 playwright test test/e2e/app.spec.js test/e2e/categories.spec.js"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@capacitor-community/file-opener": "8.0.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@fontsource-variable/archivo": "^5.2.0",
    "@fontsource/red-hat-mono": "^5.2.0",
    "@playwright/test": "^1.64.1",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.1.0"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.contractdesk.app",
    "productName": "Contract Desk",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "server/**",
      "core/**",
      "dist/**",
      "build/icon.png",
      "package.json"
    ],
    "artifactName": "Contract-Desk-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "icon": "build/icon.png",
      "synopsis": "Local contract & document manager",
      "syncDesktopName": true
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Contract Desk"
    }
  },
  "author": "Contract Desk",
  "desktopName": "contract-desk.desktop"
}
